# ==============================================================================
# MAIN CORE CONFIGURATION
# ==============================================================================
GlobalScaling.Enable = 1
GlobalScaling.AffectDungeons = 1
GlobalScaling.AffectRaids = 1
GlobalScaling.BaseLevel = 80
GlobalScaling.Dungeon.BaseLevel = 80
GlobalScaling.Raid.BaseLevel = 80
