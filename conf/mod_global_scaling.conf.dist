GlobalScaling.Instance.ScalingDelay = 1000
GlobalScaling.PeriodicCheckInterval = 1000
GlobalScaling.UpdateDistance = 150.0

GlobalScaling.ExcludedMaps = ""
GlobalScaling.ExcludedCreatures = ""

