# ==============================================================================
# CUSTOM OVERRIDES & WORLD BOSSES
# Calibrated to match ICC 25HM / Halion 25HM equivalent difficulty level.
# Format: "EntryID BaseLvl HP Mana Dmg Spell Armor Res Gold Heal DoT"
# Includes: Kazzak (18728), Doomwalker (17711), Azuregos (6109), 
# Dragons of Nightmare (14887, 14888, 14889, 14890), and Emeriss/Taerar/etc (18338)
# ==============================================================================
# 1. GlobalScaling.CustomCreatures
# Description: Allows overriding the statistics of a specific NPC or boss 
# identified by its Entry ID, regardless of its zone.
# Format: "EntryID BaseLvl HP Mana Dmg Spell Armor Res Gold Heal DoT"
# Example: Adjust a specific boss (e.g., ID 18728) :
GlobalScaling.CustomCreatures = "18728 83 25.0 10.0 2.5 2.5 1.0 1.0 5.0 1.5 1.5,17711 83 28.0 10.0 2.6 2.6 1.0 1.0 5.0 1.5 1.5,6109 83 22.0 10.0 2.2 2.2 1.0 1.0 5.0 1.5 1.5,18338 83 22.0 10.0 2.2 2.2 1.0 1.0 5.0 1.5 1.5,14887 83 24.0 10.0 2.4 2.4 1.0 1.0 5.0 1.5 1.5,14888 83 24.0 10.0 2.4 2.4 1.0 1.0 5.0 1.5 1.5,14889 83 24.0 10.0 2.4 2.4 1.0 1.0 5.0 1.5 1.5,14890 83 24.0 10.0 2.4 2.4 1.0 1.0 5.0 1.5 1.5"

# 2. GlobalScaling.CustomHealingSpells
# Description: Allows applying an exception multiplier to a specific direct 
# healing spell cast by an NPC (based on Spell ID).
# Format: "SpellID Multiplier,SpellID2 Multiplier2"
# Example: Double the effectiveness of a specific healing spell (ID 1064) :
# GlobalScaling.CustomHealingSpells = "1064 2.0"
GlobalScaling.CustomHealingSpells = ""

# 3. GlobalScaling.CustomDamageSpells
# Description: Allows adjusting the damage of a specific magic or special attack 
# of an NPC by its spell ID, independently of global spell scaling.
# Format: "SpellID Multiplier,SpellID2 Multiplier2"
# Example: Increase a boss Fireball damage (ID 133) by 30% :
# GlobalScaling.CustomDamageSpells = "133 1.3"
GlobalScaling.CustomDamageSpells = ""

# 4. GlobalScaling.CustomShieldSpells
# Description: Allows adjusting the power of absorption shields (e.g., Power Word: Shield) 
# or defensive buffs/stats conferred by specific NPC spells.
# Format: "SpellID Multiplier,SpellID2 Multiplier2"
# Example: Strengthen a boss shield (ID 17) with a 1.5 multiplier :
# GlobalScaling.CustomShieldSpells = "17 1.5"
GlobalScaling.CustomShieldSpells = ""

# 5. GlobalScaling.CustomMeleeSpells
# Description: Allows adjusting the damage of specific physical/melee special attacks 
# (e.g., Shield Slam, Cleave, Mortal Strike) by their spell ID. Useful for physical 
# abilities that don't scale properly with standard Attack Power.
# Format: "SpellID Multiplier,SpellID2 Multiplier2"
# Example: Increase a boss Shield Slam damage (ID 8242) by 300% (x3.0) :
# GlobalScaling.CustomMeleeSpells = "8242 3.0"
GlobalScaling.CustomMeleeSpells = ""

# ==============================================================================
# VISUAL SIZE OVERRIDES (MAPS & OVERWORLD)
# ==============================================================================

# 1. Overworld Size Overrides (Enable / Disable switch)
GlobalScaling.SizeOverride.Overworld.Enable = 0
# Description: Multiplies the visual size of overworld creatures per continent map ID across 5 distinct ranks.
# Format: "MapID TrashScale EliteScale EliteRareScale RareScale SkullBossScale,MapID2 ..."
# Map IDs: 0 = Eastern Kingdoms, 1 = Kalimdor, 530 = Outland / Bloodelves Zones / Draeneis Zones , 571 = Northrend
GlobalScaling.SizeOverride.Overworld = "0 1.5 2.0 2.0 2.0 2.5, 1 1.5 2.0 2.0 2.0 2.5, 530 1.5 2.0 2.0 2.0 2.5, 571 1.5 2.0 2.0 2.0 2.5"

# 2. Instances & Dungeons/Raids Size Overrides (Enable / Disable switch)
GlobalScaling.SizeOverride.Maps.Enable = 1
# Description: Multiplies the visual size of creatures per instance (MapID), distinguishing between Trash and Bosses.
# Format: "MapID TrashScale BossScale,MapID2 TrashScale2 BossScale2"
# Example: In Ragefire Chasm (389), trash scale is normal (1.0) but bosses are doubled (2.0) :
# GlobalScaling.SizeOverride.Maps = "389 1.0 2.0"
GlobalScaling.SizeOverride.Maps = "389 1.5 2.5, 36 1 2"

# 3. GlobalScaling.SizeOverride.Creatures
# Description: Multiplies the visual size of a specific creature or boss (EntryID).
# Takes priority over map and overworld settings.
# Format: "EntryID Multiplier,EntryID2 Multiplier2"
# Example: Double the size of Taragaman the Hungerer (ID 11520) :
# GlobalScaling.SizeOverride.Creatures = "11520 2.0"
GlobalScaling.SizeOverride.Creatures = "2754 2.0, 2753 2.0"
		
